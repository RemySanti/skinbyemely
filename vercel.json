{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services/:path*",
      "destination": "https://book.squareup.com/appointments/f7dcst2ljp85dq/location/LMVSQK9C6PR4T/services?buttonTextColor=ffffff&color=000000&locale=en&referrer=so",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:page(cart|order-success|owner-dashboard|square-setup|square-service-ids|square-product-ids|product-catalog|quick-products|stripe-migration|design-system)",
      "destination": "/app-shell"
    },
    {
      "source": "/products/:id",
      "destination": "/app-shell"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:page(cart|order-success|owner-dashboard|square-setup|square-service-ids|square-product-ids|product-catalog|quick-products|stripe-migration|design-system|app-shell)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
